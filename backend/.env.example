DJANGO_ENV=dev
SECRET_KEY=django-insecure-change-this-local-secret
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

DATABASE_NAME=masterygrid
DATABASE_USER=masterygrid_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
AI_GENERATION_ENABLED=True
AI_STORE_RAW_PROVIDER_RESPONSE=False
AI_DAILY_REQUEST_LIMIT_PER_USER=20
AI_ALLOW_TEACHER_SUGGESTIONS=True
AI_ALLOW_TEACHER_APPLY_SUGGESTIONS=False
